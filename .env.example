# Django
SECRET_KEY=change-this-super-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# PostgreSQL
POSTGRES_DB=brightside_db
POSTGRES_USER=brightside_user
POSTGRES_PASSWORD=brightside_pass
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# JWT
JWT_SECRET=change-this-jwt-secret
JWT_ACCESS_TOKEN_LIFETIME_MIN=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# LLM Provider: "openai" or "groq"
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Embeddings provider: "openai" or "gemini"
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=your-gemini-api-key
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Embedding vector dimension (must match model output; 1536 for text-embedding-3-small)
EMBEDDING_DIMENSION=1536

# Knowledge base chunking
KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=100
KB_TOP_K=4

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@brightside.com
PGADMIN_DEFAULT_PASSWORD=admin123

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
